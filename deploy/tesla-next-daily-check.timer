# See README.md, Weekly audit.
[Unit]
Description=Run the tesla-next daily checks every morning

[Timer]
# Long after anton finishes the previous day, and after the Monday audit starts.
OnCalendar=*-*-* 07:00:00 America/Los_Angeles
# A run missed while the server was off happens at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
