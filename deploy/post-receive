#!/bin/sh
# Deploy on push to main: check out into the app folder and rebuild containers.
# Source of truth: deploy/post-receive in the repo; see README.md, Deploy.
set -e
APP=/home/onyx/tesla-next
REPO=/home/onyx/repos/tesla-next.git

while read oldrev newrev ref; do
  if [ "$ref" != "refs/heads/main" ]; then
    echo "Received $ref; only main is deployed."
    continue
  fi

  echo "Deploying $(git --git-dir="$REPO" log -1 --format="%h %s" "$newrev")"
  git --git-dir="$REPO" --work-tree="$APP" checkout -f main
  cd "$APP"
  # A new value each deploy makes the image rerun its dependency audit.
  AUDIT_RUN=$(date +%s) docker compose up -d --build --remove-orphans
  docker image prune -f
  # Keep the most recently used 5 GB of build cache: routine builds stay fast, and the
  # cache, which filled the 98 GB disk by October 2026, stays bounded. It is shared with
  # the server's other projects. Docker 28+ renames --keep-storage to --reserved-space.
  docker builder prune -f --keep-storage 5GB || echo "warning: build cache prune failed"
  df -h "$APP" | awk 'NR==2 {print "Disk: " $4 " free of " $2 " (" $5 " used)"}'
  echo "Deploy finished."
done
