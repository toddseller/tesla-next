#!/bin/sh
# Run the tests when anything but OpenSpec artifacts or Markdown is staged.
#
# Tests run against the working tree, so unstaged edits are included; the server's
# Docker build tests the exact pushed commit. Bypass with `git commit --no-verify`.
set -eu

root=$(git rev-parse --show-toplevel)

if ! git diff --cached --name-only | grep -vqE '^openspec/|\.md$'; then
  exit 0
fi

if [ ! -d "$root/node_modules" ]; then
  echo "pre-commit: code is staged, but node_modules is missing. Install it with: yarn install" >&2
  exit 1
fi

pg_bin=${PG_BIN:-/opt/homebrew/opt/postgresql@18/bin}
if [ ! -x "$pg_bin/initdb" ] && ! command -v initdb > /dev/null; then
  echo "pre-commit: the tests need PostgreSQL 18. Install it with: brew install postgresql@18 (or set PG_BIN)" >&2
  exit 1
fi

echo "pre-commit: code staged, running Vitest"
cd "$root" && yarn -s vitest run
