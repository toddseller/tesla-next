# No password here: the container reads it from the password file below.
DATABASE_URL=postgresql://tsr_app@192.168.40.5:5432/tsr
# Host path of a libpq password file (mode 600), mounted read-only; compose sets PGPASSFILE to it.
PGPASS_FILE=/home/onyx/.pgpass
# Optional: Pushover keys for deploy/weekly-audit's alerts; without both, nothing is sent.
PUSHOVER_USER=
PUSHOVER_TOKEN=
